# Supabase PostgreSQL Database URL
# You can get this from your Supabase project dashboard -> Settings -> Database -> Connection String (URI)
# Example: postgresql://postgres.XXXXX:password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://your_user:your_password@your_host/your_db

# Telegram Bot Token (Optional)
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
